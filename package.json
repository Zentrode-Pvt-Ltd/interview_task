{
  "name": "inventory-reservation-challenge",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @inventory/api && npm run build -w @inventory/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run start -w @inventory/api"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^6.0.3"
  }
}
